# Required
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
ANTHROPIC_API_KEY=sk-ant-...

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
BOT_LANGUAGE=en                # en | he
CACHE_TTL_SECONDS=300          # how long market data is cached per ticker
USER_COOLDOWN_SECONDS=10       # min seconds between LLM calls per user
LOG_LEVEL=INFO

# Webhook mode only (production). Leave empty for local polling.
WEBHOOK_BASE_URL=                # e.g. https://your-app.onrender.com
WEBHOOK_SECRET=a-long-random-string_only-letters-digits-_-
