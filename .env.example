# Required
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
ANTHROPIC_API_KEY=sk-ant-...

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
BOT_LANGUAGE=en                # en | he
CACHE_TTL_SECONDS=300          # how long market data is cached per ticker
USER_COOLDOWN_SECONDS=10       # min seconds between LLM calls per user
USER_REQUESTS_PER_MINUTE=20    # max messages per user per minute, any command
DAILY_AI_LIMIT=50              # max Claude calls per day across all users (resets 00:00 UTC)
AI_ALLOWED_USER_IDS=           # Telegram user IDs allowed AI analysis, e.g. 123,456 (empty = nobody)
LOG_LEVEL=INFO

# Webhook mode only (production). Leave empty for local polling.
WEBHOOK_BASE_URL=                # e.g. https://your-app.onrender.com
PUBLIC_DEPLOYMENT=false         # true when reachable from the internet (the Dockerfile sets it)
DASHBOARD_USERNAME=nadav
DASHBOARD_PASSWORD=              # required with WEBHOOK_BASE_URL: 16+ chars; locally optional (localhost only)
WEBHOOK_SECRET=                  # required with WEBHOOK_BASE_URL: 32+ random chars, generate with
                                 # python -c "import secrets; print(secrets.token_urlsafe(32))"
